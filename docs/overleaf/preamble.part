\foreach \i/\yy in {1/2,2/0,3/-2}{
\node[block] (b\i) at (0,\yy) {Battery \i};
\node[block] (p\i) at (3,\yy) {GFM PCS \i};
\node[block] (z\i) at (6,\yy) {Branch $Z_b$};
\draw[<->] (b\i)--(p\i);
\draw[<->] (p\i)--(z\i);
\draw (z\i.east)--(8,\yy);
}
\draw[very thick] (8,-2.5)--(8,2.5);
\node[above] at (8,2.5) {Islanded AC bus};
